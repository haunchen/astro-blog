---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, CATEGORY_LABEL, PUBLISHER_JSONLD, pageTitle } from '../utils/site-meta';
import { ARTICLE_COVER_SIZES, CARD_IMAGE_WIDTHS, toPreloadImage } from '../utils/images';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Reading time: word count / 400, round up
const body = post.body ?? '';
const wordCount = body.length;
const readingTime = Math.max(1, Math.ceil(wordCount / 400));

// Date formatting
const formattedDate = post.data.date.toISOString().slice(0, 10);

// Prev / Next navigation
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

// Related posts: same category, exclude current, max 3
const relatedPosts = allPosts
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .slice(0, 3);

const categoryLabel = CATEGORY_LABEL[post.data.category] ?? post.data.category;

const canonicalURL = new URL(`/${post.id}/`, SITE.url).href;

// 文章封面是首屏最大的圖，等於 LCP 元素；widths/sizes 需與下方 <Image> 一字不差，
// 不一致會 preload 到另一個候選圖而白下載一份，故兩邊都取自 utils/images。
const coverImage = post.data.cover
  ? await getImage({
      src: post.data.cover,
      widths: CARD_IMAGE_WIDTHS,
      sizes: ARTICLE_COVER_SIZES,
    })
  : undefined;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  image: `${SITE.url}/og/${post.id}.png`,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/about/`,
  },
  // 內聯而非 @id 參照：Google 要求 publisher.name / publisher.logo 在該筆 Article 內可解析
  publisher: PUBLISHER_JSONLD,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  articleSection: categoryLabel,
  keywords: post.data.tags?.join(', '),
  wordCount,
  isPartOf: { '@id': `${SITE.url}/#website` },
  inLanguage: 'zh-TW',
};

// 可見麵包屑與 BreadcrumbList JSON-LD 的上層階層共用同一個陣列，避免兩邊走鐘
const crumbs = [
  { name: '首頁', href: '/' },
  { name: '文章', href: '/articles/' },
];
---

<BaseLayout
  title={pageTitle(post.data.title)}
  description={post.data.description}
  ogImage={`/og/${post.id}.png`}
  preloadImage={coverImage && toPreloadImage(coverImage, ARTICLE_COVER_SIZES)}
  article={{
    publishedTime: post.data.date,
    modifiedTime: post.data.updated,
    tags: post.data.tags,
  }}
  jsonLd={[blogPosting]}
  breadcrumbs={crumbs}
>
  <main>
    <!-- Article Header -->
    <div class="article-header">
      <!-- 可見麵包屑：文章頁原本只有 BreadcrumbList JSON-LD 而畫面上沒有對應的
           導覽，與站上其餘 9 個內頁不一致，也讓結構化資料宣稱了頁面上看不到的
           階層。current 直接用 post.data.title——BaseLayout 的 JSON-LD 末階是
           title 去掉品牌後綴後的結果，兩者必須是同一字串。 -->
      <Breadcrumbs items={crumbs} current={post.data.title} />
      <div class="article-header-meta">
        <TagBadge text={categoryLabel} href={`/category/${post.data.category}/`} />
        <span class="article-header-date">{formattedDate}</span>
      </div>
      <h1>{post.data.title}</h1>
      <div class="article-header-info">{readingTime} min read</div>
    </div>

    <!-- Article Cover -->
    <div class="article-header" style="padding-top:0;">
      {post.data.cover ? (
        <Image
          src={post.data.cover}
          alt={post.data.title}
          class="article-cover-img"
          widths={CARD_IMAGE_WIDTHS}
          sizes={ARTICLE_COVER_SIZES}
        />
      ) : (
        <div class="article-cover">▨ COVER</div>
      )}
    </div>

    <!-- Two-column layout -->
    <div class="layout-with-aside">
      <div class="layout-main">
        <div class="prose">
          <Content />
        </div>

        <!-- 文章標籤：frontmatter 的 tags 原本只用在 article:tag 與 JSON-LD keywords，
             頁面上完全沒有出口，導致 54 個標籤頁的唯一入站連結只有 /tag/ 索引頁。
             列在正文之後而非標題下方，是因為讀完才是想找相關內容的時機。 -->
        {post.data.tags && post.data.tags.length > 0 && (
          <nav class="article-tags" aria-label="文章標籤">
            <span class="article-tags-label">標籤</span>
            <ul class="article-tags-list">
              {post.data.tags.map((tag) => (
                <li>
                  <TagBadge text={tag} href={`/tag/${encodeURIComponent(tag)}/`} size="sm" />
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- Article Nav (prev / next) -->
        <nav class="article-nav">
          {prevPost ? (
            <a href={`/${prevPost.id}/`} class="article-nav-item">
              <div class="article-nav-label">← 上一篇</div>
              <div class="article-nav-title">{prevPost.data.title}</div>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/${nextPost.id}/`} class="article-nav-item article-nav-item--next">
              <div class="article-nav-label">下一篇 →</div>
              <div class="article-nav-title">{nextPost.data.title}</div>
            </a>
          ) : <div />}
        </nav>
      </div>

      <!-- Aside -->
      <aside class="layout-aside">
        <!-- Author widget -->
        <div class="aside-widget">
          <div class="aside-widget-title">作者</div>
          <div class="aside-author">
            <div class="aside-author-avatar">F</div>
            <div>
              <div class="aside-author-name">{SITE.author}</div>
              <div class="aside-author-role">系統整合工程師</div>
            </div>
          </div>
          <div class="aside-author-bio">從只會寫程式，到跨領域學習電路、製程、架站。分享實戰經驗與踩坑紀錄。</div>
        </div>

        <!-- Related posts widget -->
        {relatedPosts.length > 0 && (
          <div class="aside-widget">
            <div class="aside-widget-title">相關文章</div>
            {relatedPosts.map((rp) => (
              <a href={`/${rp.id}/`} class="aside-related-item">
                <div class="aside-related-title">{rp.data.title}</div>
                <div class="aside-related-date">{rp.data.date.toISOString().slice(0, 10)}</div>
              </a>
            ))}
          </div>
        )}

        <!-- Table of Contents -->
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* Article Header */
  .article-header {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 48px 24px 32px;
  }

  .article-header-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    font-family: var(--font-sans);
    font-size: 14px;
  }

  .article-header-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .article-header h1 {
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 48px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .article-header-info {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 32px;
    letter-spacing: 0.02em;
  }

  /* Article Cover */
  .article-cover {
    width: 100%;
    height: 360px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .article-cover-img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-tertiary);
  }

  /* Two-column layout */
  .layout-with-aside {
    display: flex;
    gap: 48px;
    max-width: var(--width-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .layout-main {
    flex: 1;
    min-width: 0;
  }

  .layout-aside {
    width: 240px;
    flex-shrink: 0;
  }

  /* Article Tags */
  .article-tags {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .article-tags-label {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .article-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 標籤已接在正文後，prev/next 不需要再畫一條分隔線 */
  .article-tags + .article-nav {
    margin-top: 32px;
    padding-top: 0;
    border-top: none;
  }

  /* Article Nav */
  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .article-nav-item {
    flex: 1;
    text-decoration: none;
    color: inherit;
    padding: 16px;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
  }

  .article-nav-item:hover {
    animation: einkRefresh 500ms steps(4) forwards;
  }

  .article-nav-item--next {
    text-align: right;
  }

  .article-nav-label {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .article-nav-title {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 22px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Aside Widgets */
  .aside-widget {
    margin-bottom: 32px;
  }

  .aside-widget-title {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .aside-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .aside-author-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-default);
    background: var(--color-bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .aside-author-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
  }

  .aside-author-role {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .aside-author-bio {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-text-secondary);
  }

  .aside-related-item {
    display: block;
    padding: 8px 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .aside-related-item:last-child {
    border-bottom: none;
  }

  .aside-related-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 300ms steps(3);
  }

  .aside-related-item:hover .aside-related-title {
    color: var(--color-brand-orange);
  }

  .aside-related-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: 2px;
    letter-spacing: 0.02em;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .layout-aside {
      display: none;
    }

    .layout-with-aside {
      display: block;
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .article-header h1 {
      font-size: 28px;
      line-height: 38px;
    }

    .article-cover,
    .article-cover-img {
      height: 200px;
    }

    .article-nav {
      flex-direction: column;
    }
  }
</style>
