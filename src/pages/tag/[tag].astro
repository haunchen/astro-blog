---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTimeline from '../../components/ArticleTimeline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  categoryLabel,
  collectionPageJsonLd,
  listPageDescription,
  pageTitle,
} from '../../utils/site-meta';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tagSet.add(t);
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag, tagPosts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  tagPosts: CollectionEntry<'posts'>[];
}

const { tag, tagPosts } = Astro.props;

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = `標籤：${tag}｜相關技術文章與實作筆記整理`;
const crumbs = [
  { name: '首頁', href: '/' },
  { name: '標籤', href: '/tag/' },
];
// ItemList 順序需與畫面一致：ArticleTimeline 以日期新到舊排列
const sorted = [...tagPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const listed = sorted.map((p) => ({ title: p.data.title, path: `/${p.id}/` }));

// 描述以該標籤實際的資料組出（篇數、涵蓋分類、最新幾篇標題），避免 55 個標籤頁
// 共用同一句樣板而被視為近似重複的描述——組裝邏輯見 listPageDescription。
const tagCategories = [...new Set(sorted.map((p) => p.data.category))].map(categoryLabel);
const description = listPageDescription({
  lead: `站上標記「${tag}」的技術文章共 ${tagPosts.length} 篇，涵蓋${tagCategories.join('、')}，依發表日期由新到舊排列。`,
  titles: sorted.map((p) => p.data.title),
  // 只有一兩篇文章的冷門標籤，光靠篇數與標題湊不到下限，逐句補到達標為止。
  // 分成多句而非一長句，是為了讓補到不同長度的頁面結尾也不同。
  padding: [
    '每篇都是實際做過一輪後留下的設定步驟與踩坑紀錄。',
    '想一次看完這個主題在站上累積的內容，從這裡進入最快。',
    '文章會隨著新的實作經驗持續補充。',
  ],
});
---

<BaseLayout
  title={pageTitle(pageName)}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[
    collectionPageJsonLd({
      name: pageName,
      description,
      path: `/tag/${encodeURIComponent(tag)}/`,
      items: listed,
    }),
  ]}
>
  <main class="list-page">
    <Breadcrumbs items={crumbs} current={pageName} />
    <header class="list-head">
      <h1 class="list-title">標籤：{tag}</h1>
      <p class="list-sub">共 {tagPosts.length} 篇</p>
    </header>

    <ArticleTimeline posts={tagPosts} />
  </main>
</BaseLayout>
