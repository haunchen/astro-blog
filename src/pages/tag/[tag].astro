---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTimeline from '../../components/ArticleTimeline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { collectionPageJsonLd, pageTitle } from '../../utils/site-meta';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tagSet.add(t);
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag, tagPosts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  tagPosts: CollectionEntry<'posts'>[];
}

const { tag, tagPosts } = Astro.props;

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = `標籤：${tag}｜相關技術文章與實作筆記整理`;
const crumbs = [
  { name: '首頁', href: '/' },
  { name: '標籤', href: '/tag/' },
];
const description = `所有標記「${tag}」的技術文章，目前共 ${tagPosts.length} 篇，依發表日期由新到舊排列。這裡集中收錄與這個主題相關的實作步驟、設定範例與踩坑紀錄，方便你快速找到同一個工具或使用情境下的延伸閱讀，不必回到文章總覽逐篇翻找，也能一次看完這個主題在站上累積的所有內容。`;

// ItemList 順序需與畫面一致：ArticleTimeline 以日期新到舊排列
const listed = [...tagPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ title: p.data.title, path: `/${p.id}/` }));
---

<BaseLayout
  title={pageTitle(pageName)}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[
    collectionPageJsonLd({
      name: pageName,
      description,
      path: `/tag/${encodeURIComponent(tag)}/`,
      items: listed,
    }),
  ]}
>
  <main class="list-page">
    <Breadcrumbs items={crumbs} current={pageName} />
    <header class="list-head">
      <h1 class="list-title">標籤：{tag}</h1>
      <p class="list-sub">共 {tagPosts.length} 篇</p>
    </header>

    <ArticleTimeline posts={tagPosts} />
  </main>
</BaseLayout>
