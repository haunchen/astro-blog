---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, pageTitle } from '../utils/site-meta';

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = '隱私權政策｜資料蒐集、Cookie 與第三方內容說明';
const crumbs = [{ name: '首頁', href: '/' }];
---

<BaseLayout
  title={pageTitle(pageName)}
  description="本站的隱私權政策：說明本站為靜態網站、不主動蒐集個人資料，並逐項解釋 Google Analytics 與 Cloudflare Web Analytics 的流量統計、Google AdSense 廣告與第三方 Cookie 的運作方式、如何退出個人化廣告，以及第三方嵌入內容與外部連結的處理。"
  breadcrumbs={crumbs}
>
  <main class="legal">
    <Breadcrumbs items={crumbs} current={pageName} />
    <h1 class="legal-title">隱私權政策</h1>
    <p class="legal-updated">最後更新：2026-08-10</p>

    <div class="prose">
      <h2>我們是誰</h2>
      <p>本網站網址為 {SITE.url}，由 Frank Chen 經營。如有任何隱私相關問題，歡迎來信 <a href={`mailto:${SITE.email}`}>{SITE.email}</a>。</p>

      <h2>我們蒐集哪些資料</h2>
      <p>本站為靜態網站，不提供留言、註冊或登入功能，因此不會主動向你蒐集姓名、電子郵件等可直接識別身分的個人資料。瀏覽本站時，資料蒐集來自下列三項服務：流量統計的 Google Analytics 與 Cloudflare Web Analytics，以及「廣告」一節說明的 Google AdSense。</p>
      <p>本站啟用 Google Analytics 4（評估 ID：G-J4PFZEBYW7）統計流量。它會設置 Cookie 以區分不重複的瀏覽器與工作階段，蒐集你瀏覽的頁面、來源網站、裝置與瀏覽器類型、以及國家／城市層級的概略地理位置。這項服務透過 Cloudflare 的 Google 代碼閘道以第一方模式運作——測量請求先送到本站網域，再由 Cloudflare 轉寄給 Google。也因為採第一方模式，Google 官方的 <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener noreferrer" target="_blank">Google Analytics 停用瀏覽器外掛程式</a>（作用對象是送往 Google 網域的請求）可能攔不到本站的測量請求；若要完全避免，請使用瀏覽器層級的追蹤防護或內容封鎖工具。</p>
      <p>代管平台 Cloudflare 提供的 Web Analytics 亦為啟用狀態。它以無 Cookie 的方式運作，僅彙總網頁瀏覽量、來源網站、裝置類型等統計資訊，不使用 Cookie、不追蹤個別使用者，也不會跨網站建立你的行為輪廓。相關說明見 <a href="https://developers.cloudflare.com/web-analytics/" rel="noopener noreferrer" target="_blank">Cloudflare Web Analytics 文件</a>。</p>

      <h2>廣告</h2>
      <p>本站文章頁面投放 Google AdSense 廣告。Google 及其合作夥伴會使用 Cookie 或類似技術，依你先前造訪本站與其他網站的紀錄放送廣告，這類 Cookie 由 Google 設置與讀取，本站無法存取其內容。</p>
      <p>你可以前往 <a href="https://myadcenter.google.com/" rel="noopener noreferrer" target="_blank">Google 廣告設定</a> 關閉個人化廣告；關閉後仍會看到廣告，但內容不再依你的瀏覽紀錄調整。若想更全面地管理第三方廣告 Cookie，可參考 <a href="https://www.aboutads.info/choices/" rel="noopener noreferrer" target="_blank">aboutads.info</a> 的退出工具。</p>

      <h2>Cookie</h2>
      <p>Google Analytics 會在你的瀏覽器設置 <code>_ga</code> 與 <code>_ga_J4PFZEBYW7</code> 兩個 Cookie，用途是區分不重複的瀏覽器與工作階段，內容為隨機識別碼與時間戳記，不含姓名、電子郵件這類可直接識別你身分的資訊。Cloudflare Web Analytics 則完全不使用 Cookie。除此之外與上述廣告 Cookie 外，本站本身不設置其他用於識別身分或跨站追蹤的 Cookie。網站由 Cloudflare Pages 代管，平台可能基於資訊安全與效能設置必要性 Cookie；這類 Cookie 不用於識別你的身分。</p>

      <h2>第三方嵌入內容</h2>
      <p>本站文章可能嵌入來自第三方網站的內容（例如圖片、影片、程式碼片段）。這些內容的隱私權處理方式，與你直接造訪該第三方網站時相同；它們可能會蒐集你的資料、使用 Cookie，或追蹤你與嵌入內容的互動。</p>

      <h2>外部連結</h2>
      <p>本站文章可能包含指向外部網站的連結。一旦你離開本站，我們無法為其他網站的隱私權做法負責，建議你查閱該網站自己的隱私權政策。</p>

      <h2>你的權利與聯絡方式</h2>
      <p>本站不會主動向你索取姓名、電子郵件這類可直接識別身分的個人資料，因此通常沒有可供查詢或刪除的個人資料。上述分析與廣告服務蒐集的資料由 Google 與 Cloudflare 各自保管，若要行使相關權利，請一併參考 <a href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google 隱私權政策</a>。如你仍有任何疑問或要求，歡迎來信 <a href={`mailto:${SITE.email}`}>{SITE.email}</a>。</p>
    </div>
  </main>
</BaseLayout>

<style>
  .legal {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: 64px 24px;
  }

  .legal-title {
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 48px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .legal-updated {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 8px 0 32px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .legal {
      padding: 40px 16px;
    }

    .legal-title {
      font-size: 28px;
      line-height: 38px;
    }
  }
</style>
