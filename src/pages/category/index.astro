---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, collectionPageJsonLd, pageTitle } from '../../utils/site-meta';

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = '分類';
const crumbs = [{ name: '首頁', href: '/' }];
const description = '依主題瀏覽所有技術文章分類：n8n 自動化、架站部署、Flutter、樹莓派與開發工具。';

// 本頁列出的是分類頁而非文章，ItemList 需與 CategoryGrid 的篩選條件（有文章才顯示）一致
const posts = await getCollection('posts', ({ data }) => !data.draft);
const listed = CATEGORIES
  .filter(({ slug }) => posts.some((p) => p.data.category === slug))
  .map(({ slug, label }) => ({ title: label, path: `/category/${slug}/` }));
---

<BaseLayout
  title={pageTitle(pageName)}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[collectionPageJsonLd({ name: pageName, description, path: '/category/', items: listed })]}
>
  <main class="list-page">
    <Breadcrumbs items={crumbs} current={pageName} />
    <header class="list-head">
      <h1 class="list-title">分類</h1>
      <p class="list-sub">依主題瀏覽文章</p>
    </header>

    <CategoryGrid />
  </main>
</BaseLayout>
