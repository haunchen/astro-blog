---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTimeline from '../../components/ArticleTimeline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CATEGORIES, categoryLabel, collectionPageJsonLd, pageTitle } from '../../utils/site-meta';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return CATEGORIES
    .map(({ slug }) => {
      const categoryPosts = posts.filter((p) => p.data.category === slug);
      return { params: { category: slug }, props: { categoryPosts, slug } };
    })
    .filter((entry) => entry.props.categoryPosts.length > 0);
}

interface Props {
  categoryPosts: CollectionEntry<'posts'>[];
  slug: string;
}

const { categoryPosts, slug } = Astro.props;
const label = categoryLabel(slug);

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = `${label}｜相關教學文章、實作紀錄與踩坑經驗整理`;
const crumbs = [
  { name: '首頁', href: '/' },
  { name: '分類', href: '/category/' },
];
const description = `瀏覽「${label}」分類的所有技術文章，目前共 ${categoryPosts.length} 篇，依發表日期由新到舊排列。內容涵蓋完整實作步驟、設定範例、踩坑紀錄與心得整理，都是實際做過一輪後才寫下來的筆記，適合想深入這個主題的讀者依序閱讀，也可以直接挑出目前需要的段落參考，避免重複踩同樣的坑。`;

// ItemList 順序需與畫面一致：ArticleTimeline 以日期新到舊排列
const listed = [...categoryPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ title: p.data.title, path: `/${p.id}/` }));
---

<BaseLayout
  title={pageTitle(pageName)}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[
    collectionPageJsonLd({
      name: pageName,
      description,
      path: `/category/${slug}/`,
      items: listed,
    }),
  ]}
>
  <main class="list-page">
    <Breadcrumbs items={crumbs} current={pageName} />
    <header class="list-head">
      <h1 class="list-title">{label}</h1>
      <p class="list-sub">共 {categoryPosts.length} 篇</p>
    </header>

    <ArticleTimeline posts={categoryPosts} />
  </main>
</BaseLayout>
