---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTimeline from '../../components/ArticleTimeline.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { type CollectionEntry } from 'astro:content';
import {
  CATEGORIES,
  categoryLabel,
  collectionPageJsonLd,
  listPageDescription,
  pageTitle,
} from '../../utils/site-meta';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES
    .map(({ slug }) => {
      const categoryPosts = posts.filter((p) => p.data.category === slug);
      return { params: { category: slug }, props: { categoryPosts, slug } };
    })
    .filter((entry) => entry.props.categoryPosts.length > 0);
}

interface Props {
  categoryPosts: CollectionEntry<'posts'>[];
  slug: string;
}

const { categoryPosts, slug } = Astro.props;
const label = categoryLabel(slug);

// 頁名單一來源：<title>、可見麵包屑末階與 BreadcrumbList 末階必須是同一字串
const pageName = `${label}｜相關教學文章、實作紀錄與踩坑經驗整理`;
const crumbs = [
  { name: '首頁', href: '/' },
  { name: '分類', href: '/category/' },
];
// ItemList 順序需與畫面一致：ArticleTimeline 以日期新到舊排列
const sorted = [...categoryPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const listed = sorted.map((p) => ({ title: p.data.title, path: `/${p.id}/` }));

// 與標籤頁用同一支產生器：原本 5 個分類頁共用同一句樣板、只換標籤名與篇數，
// 跟標籤頁修正前是同一個問題（近似重複的描述）。padding 句子與標籤頁刻意不同，
// 否則兩種列表頁補完之後結尾又會撞在一起。
const description = listPageDescription({
  lead: `「${label}」分類目前收錄 ${categoryPosts.length} 篇技術文章，依發表日期由新到舊排列，內容涵蓋完整實作步驟、設定範例與踩坑紀錄。`,
  titles: sorted.map((p) => p.data.title),
  padding: [
    '每篇都是實際做過一輪之後才寫下來的筆記。',
    '可以依序讀完，也可以直接挑出目前需要的段落參考。',
  ],
});
---

<BaseLayout
  title={pageTitle(pageName)}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[
    collectionPageJsonLd({
      name: pageName,
      description,
      path: `/category/${slug}/`,
      items: listed,
    }),
  ]}
>
  <main class="list-page">
    <Breadcrumbs items={crumbs} current={pageName} />
    <header class="list-head">
      <h1 class="list-title">{label}</h1>
      <p class="list-sub">共 {categoryPosts.length} 篇</p>
    </header>

    <ArticleTimeline posts={categoryPosts} />
  </main>
</BaseLayout>
