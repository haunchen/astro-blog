---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TagBadge from '../components/TagBadge.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
// 首頁的標題、描述、關於我文案與專案清單都在 HOME（site-meta.ts）——/index.md 讀同一份。
import { SITE, HOME } from '../utils/site-meta';
import { CARD_IMAGE_WIDTHS, FEATURED_IMAGE_SIZES, toPreloadImage } from '../utils/images';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = latestPosts[0];
// 首屏 featured 卡的封面就是 LCP 元素。用 getImage() 取得與 ArticleCard 內
// <Image> 完全相同的產出，交給 BaseLayout 輸出 preload；參數若不一致會 preload
// 到另一個變體、白下載一份，所以 widths/sizes 兩邊都取自 utils/images。
const featuredCover = featured?.data.cover
  ? await getImage({
      src: featured.data.cover,
      widths: CARD_IMAGE_WIDTHS,
      sizes: FEATURED_IMAGE_SIZES,
    })
  : undefined;
const rest = latestPosts.slice(1, 4);

const projects = HOME.projects;
---

<BaseLayout
  title={HOME.title}
  description={HOME.description}
  ogImage={HOME.ogImage}
  preloadImage={featuredCover && toPreloadImage(featuredCover, FEATURED_IMAGE_SIZES)}
  markdownVariant="/index.md"
>
  <main>
    <h1 class="visually-hidden">{SITE.name}｜{SITE.tagline}</h1>
    <!-- 最新文章 -->
    <div class="container">
      <div class="section" id="latest">
        <div class="section-header">
          <h2 class="section-title">最新文章</h2>
          {/* 連結文字須單獨可讀：同站多處出現的「查看全部」指向不同頁面，對螢幕閱讀器等同無意義 */}
          <a href="/articles/" class="section-link">查看全部文章 &rarr;</a>
        </div>
        {latestPosts.length > 0 && (
          <div style="display:grid;gap:24px;">
            {featured && (
              <ArticleCard
                title={featured.data.title}
                description={featured.data.description}
                date={featured.data.date}
                category={featured.data.category}
                slug={featured.id}
                cover={featured.data.cover}
                featured={true}
              />
            )}
            {rest.length > 0 && (
              <div class="card-grid--three">
                {rest.map((post) => (
                  <ArticleCard
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.date}
                    category={post.data.category}
                    slug={post.id}
                    cover={post.data.cover}
                  />
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- 探索主題 -->
    <div class="container">
      <div class="section">
        <div class="section-header">
          <h2 class="section-title">探索主題</h2>
        </div>
        <CategoryGrid />
      </div>
    </div>

    <!-- 關於我 -->
    <div class="container">
      <div class="section">
        <div class="section-header">
          <h2 class="section-title">關於我</h2>
          <a href="/about/" class="section-link">更多關於我 &rarr;</a>
        </div>
        <div class="about-preview">
          <div class="about-avatar">F</div>
          <div class="about-content">
            <p class="about-bio">{HOME.about.bio}</p>
            <p class="about-role">{HOME.about.role}</p>
            <div class="about-tags">
              {HOME.about.tags.map((tag) => (
                <TagBadge text={tag} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 專案作品 -->
    <div class="container">
      <div class="section">
        <div class="section-header">
          <h2 class="section-title">專案作品</h2>
          <a href="/about/" class="section-link">查看全部專案作品 &rarr;</a>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <div class="project-card">
              <div class="project-image">[ {project.name} 截圖 ]</div>
              <div class="project-body">
                <div class="project-name">{project.name}</div>
                <div class="project-desc">{project.desc}</div>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <TagBadge text={tag} size="sm" />
                  ))}
                </div>
                <a href={project.link} class="project-link">{project.linkText}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Section */
  .section {
    padding: 80px 0;
  }

  .container + .container .section {
    border-top: 1px solid var(--color-border-subtle);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 38px;
    font-weight: 600;
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 2px solid rgba(251, 146, 60, 0.4);
    border-bottom: 2px solid color-mix(in srgb, var(--color-brand-orange) 40%, transparent);
    transition: border-color 300ms steps(3), background-color 300ms steps(3);
  }

  .section-link:hover {
    border-bottom-color: var(--color-brand-orange);
    background-color: rgba(251, 146, 60, 0.1);
    background-color: color-mix(in srgb, var(--color-brand-orange) 10%, transparent);
  }

  /* Card grid (for regular article cards) */
  .card-grid--three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* About preview */
  .about-preview {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .about-avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-border-default);
    background: var(--color-bg-tertiary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 32px;
    color: var(--color-text-muted);
  }

  .about-content {
    flex: 1;
  }

  .about-bio {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 28px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .about-role {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .about-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Project grid & cards */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .project-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .project-card:hover {
    animation: einkRefresh 500ms steps(4) forwards;
  }

  .project-image {
    width: 100%;
    height: 140px;
    background: var(--color-bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border-default);
  }

  .project-body {
    padding: 16px;
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .project-desc {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }

  .project-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .project-link {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 2px solid rgba(251, 146, 60, 0.4);
    border-bottom: 2px solid color-mix(in srgb, var(--color-brand-orange) 40%, transparent);
    transition: border-color 300ms steps(3), background-color 300ms steps(3);
  }

  .project-link:hover {
    border-bottom-color: var(--color-brand-orange);
    background-color: rgba(251, 146, 60, 0.1);
    background-color: color-mix(in srgb, var(--color-brand-orange) 10%, transparent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .card-grid--three {
      grid-template-columns: 1fr;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .about-preview {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about-tags {
      justify-content: center;
    }

    .section {
      padding: 48px 0;
    }

    .container {
      padding: 0 16px;
    }
  }
</style>
