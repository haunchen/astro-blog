---
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import JsonLd from '../components/JsonLd.astro';
import { SITE, OG_FALLBACK, ORGANIZATION_JSONLD, WEBSITE_JSONLD } from '../utils/site-meta';
import { pagePathToMdPath } from '../../scripts/lib/md-path.mjs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 由 scripts/build-font-css.mjs 於 build 前產生：只含站上實際用到的 @font-face 分片。
// 取代原本 11 支 @fontsource CSS 全量匯入（220KB → 39KB render-blocking CSS）。
import '../styles/fonts.css';
import fontPreloads from '../styles/font-preloads.json';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 文章頁傳入：og:type 轉 article，輸出 article:published_time / modified_time / tag */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  jsonLd?: object[];
  /** 麵包屑（不含當前頁）；傳入時自動輸出 BreadcrumbList JSON-LD 與可見導覽 */
  breadcrumbs?: { name: string; href: string }[];
  /** 該頁不希望被索引（404 等） */
  noindex?: boolean;
  /**
   * 首屏 LCP 圖片（經 astro:assets 處理後的結果）。
   * 傳入才會輸出 <link rel="preload">——只有真的是 LCP 元素的那一張該preload，
   * 亂加會搶掉關鍵資源的頻寬反而更慢。
   *
   * 圖片有 srcset 時，preload 也必須帶 imagesrcset/imagesizes 且值要與 <img>
   * 上的一模一樣：只給 href 的話瀏覽器會先預載那一個固定網址，渲染時再依 sizes
   * 挑一次候選圖，兩次挑到不同張就等於下載兩份，比不 preload 還慢。
   */
  preloadImage?: { src: string; srcSet?: string; sizes?: string };
  /**
   * 該頁 markdown 變體的路徑（例如 `/some-slug.md`）。
   *
   * 不傳則由 `Astro.url.pathname` 自動推導——全站頁面都有 md 變體（見 agent-markdown R10），
   * 逐頁傳一次等於九個檔案各改一遍，而且新增頁面時一定會有人忘記。
   * `noindex` 的頁面（404）沒有對應產物，自動推導會跳過它們。
   */
  markdownVariant?: string;
}

const {
  title,
  description = '',
  ogImage,
  article,
  jsonLd = [],
  breadcrumbs,
  noindex = false,
  preloadImage,
  markdownVariant,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// og:image 不可為空：頁面未指定時 fallback 站台 cover 圖
const ogImagePath = ogImage ?? OG_FALLBACK.src;
const ogImageURL = new URL(ogImagePath, Astro.site).href;

// og:image 的 type/width/height 必須對應「實際那張圖」，不能寫死。
// 文章頁用 /og/*.png（satori 產生，固定 1200×630）；其餘頁面 fallback 到 cover 圖。
// 原本三個值一律寫死成 1200/630/png，對約 69 個非文章頁輸出的是不實的中繼資料——
// 欄位齊全但值是錯的，社群平台依這些值配版會得到錯誤結果。
//
// cover 那一側的尺寸與格式現在來自 OG_FALLBACK（讀 astro:assets 的 ImageMetadata），
// 換圖就自動跟著換。判斷仍以 .png 結尾分流：站上只有 satori 那批是 png，
// cover 走 astro:assets 後檔名帶雜湊但副檔名不變，這條分流照樣成立。
const OG_IMAGE_META = ogImagePath.endsWith('.png')
  ? { type: 'image/png', width: '1200', height: '630' }
  : { type: OG_FALLBACK.type, width: OG_FALLBACK.width, height: OG_FALLBACK.height };

// BreadcrumbList：最後一階為當前頁，依 schema.org 慣例省略 item（自身即為 item）
const breadcrumbJsonLd = breadcrumbs?.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          ...breadcrumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: new URL(crumb.href, SITE.url).href,
          })),
          {
            '@type': 'ListItem',
            position: breadcrumbs.length + 1,
            // title 已含品牌後綴（pageTitle()），麵包屑只要頁名
            name: title.replace(` - ${SITE.name}`, ''),
          },
        ],
      },
    ]
  : [];

// Astro.url.pathname 在靜態建置下未必帶結尾斜線（視路由定義而定），而 md 路徑映射以
// 「頁面一律帶結尾斜線」為前提。先正規化再推導，否則宣告會靜默消失——HTML 照樣正常，
// 只是 agent 少了一條發現管道。verify-seo 有一條斷言專門守這件事。
const normalizedPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const resolvedMarkdownVariant =
  markdownVariant ?? (noindex ? undefined : (pagePathToMdPath(normalizedPath) ?? undefined));

const allJsonLd = [ORGANIZATION_JSONLD, WEBSITE_JSONLD, ...breadcrumbJsonLd, ...jsonLd];
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    {/* GA4 的 config 指令。載入器不在這裡——Cloudflare 的 Google 代碼閘道會在邊緣把
        <script async src="/ql0n/">（gtag.js 的第一方代理）注入到 <head> 最前面，但它注入的
        bootstrap 只有 gtag('js') 與 gtag('set','developer_id')，沒有 config，所以容器會初始化
        卻一筆事件都不送。2026-08-10 之前 GA4 就是這樣整整收不到資料（見 docs/specs/seo-perfection.md R5）。
        這裡補的就是 Google 官方安裝碼裡缺掉的那一行。

        刻意不用 is:inline：讓 Astro 把它打包成外部 module（assetsInlineLimit: 0），
        維持「全站零 inline script」的紀律，也不會在收緊版的 Report-Only CSP 上多一則違規。
        gtag 因此是 module 作用域而非全域，但我們只需要往 dataLayer 推指令，夠用；
        真要全域 gtag 的話，閘道注入的 bootstrap 已經定義了一個。

        SPA 式換頁（ClientRouter）不會重跑這支 script，換頁的 page_view 由 GA4 加強型評估的
        「根據瀏覽器記錄事件變更」接手。

        push 的必須是 arguments 物件本身，不能改寫成 push(['config', ...])。實測過：推陣列
        gtag.js 完全不理，一筆 collect 都不會出去，而且沒有任何錯誤訊息。 */}
    <script>
      const w = window as unknown as { dataLayer?: IArguments[] };
      const dataLayer = (w.dataLayer = w.dataLayer ?? []);
      function gtag(..._args: unknown[]) {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-J4PFZEBYW7');
    </script>
    {
      /* 首屏字型 preload：避免 CSS → @font-face → woff2 的三層請求鏈拖慢 LCP。
         清單由 build-font-css.mjs 產生；檔名的內容雜湊也由該腳本加上（fontsource 原始檔名不含雜湊）。 */
      fontPreloads.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    {
      /* LCP 圖片 preload：圖片藏在 CSS 之後才被發現，preload 讓它與 CSS 並行下載。 */
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage.src}
          as="image"
          fetchpriority="high"
          imagesrcset={preloadImage.srcSet || undefined}
          imagesizes={preloadImage.sizes || undefined}
        />
      )
    }
    <!--
      robots 一律由 astro-seo 輸出：它無論如何都會產生一個 <meta name="robots">，
      自己再加第二個會出現互相矛盾的宣告。額外指令走 robotsExtras 併進同一個 meta，
      讓 Google 出大圖預覽與完整摘要（預設會截短，直接影響 SERP 版位）。
    -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      noindex={noindex}
      nofollow={noindex}
      robotsExtras={noindex
        ? undefined
        : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
      extend={{
        meta: [
          { name: 'author', content: SITE.author },
          { property: 'og:image:alt', content: description || title },
          { property: 'og:image:width', content: OG_IMAGE_META.width },
          { property: 'og:image:height', content: OG_IMAGE_META.height },
          { property: 'og:image:type', content: OG_IMAGE_META.type },
          ...(SITE.twitterHandle
            ? [
                { name: 'twitter:site', content: SITE.twitterHandle },
                { name: 'twitter:creator', content: SITE.twitterHandle },
              ]
            : []),
          ...(SITE.googleSiteVerification
            ? [{ name: 'google-site-verification', content: SITE.googleSiteVerification }]
            : []),
        ],
      }}
      openGraph={{
        basic: {
          title,
          type: article ? 'article' : 'website',
          image: ogImageURL,
        },
        optional: {
          description,
          locale: 'zh_TW',
          siteName: SITE.name,
        },
        ...(article && {
          article: {
            publishedTime: article.publishedTime.toISOString(),
            ...(article.modifiedTime && { modifiedTime: article.modifiedTime.toISOString() }),
            ...(article.tags && article.tags.length > 0 && { tags: [...article.tags] }),
            authors: [SITE.author],
          },
        }),
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImageURL,
        imageAlt: description || title,
      }}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {/* 單一語系站台，hreflang 只需自我宣告 + x-default，避免搜尋引擎誤判地區變體。
        值必須與 <html lang> 完全一致（zh-TW），否則驗證器認不出這是自我宣告。 */}
    <link rel="alternate" hreflang="zh-TW" href={canonicalURL.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />
    {resolvedMarkdownVariant && (
      <link rel="alternate" type="text/markdown" href={resolvedMarkdownVariant} />
    )}
    <JsonLd data={allJsonLd} />
    <ClientRouter />
  </head>
  <body
    style={`
      font-family: var(--font-serif);
      background-color: var(--color-bg-primary);
      color: var(--color-text-primary);
      line-height: 1.75;
    `}
    transition:animate={{
      forwards: {
        old: [{ name: 'einkExit', duration: '400ms', easing: 'ease-in-out', fillMode: 'forwards' }],
        new: [{ name: 'einkEnter', duration: '400ms', easing: 'ease-in-out', fillMode: 'backwards' }],
      },
      backwards: {
        old: [{ name: 'einkExit', duration: '400ms', easing: 'ease-in-out', fillMode: 'forwards' }],
        new: [{ name: 'einkEnter', duration: '400ms', easing: 'ease-in-out', fillMode: 'backwards' }],
      },
    }}
  >
    <a href="#main-content" class="skip-link">跳到主內容</a>
    <Nav />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
