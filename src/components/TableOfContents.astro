---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <div class="aside-toc">
    <div class="aside-widget-title">目錄</div>
    <ul class="toc-list">
      {filtered.map((h) => (
        <li>
          <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : ''}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<script>
  function initToc() {
    const tocLinks = document.querySelectorAll('.toc-list a');
    if (tocLinks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
            });
          }
        }
      },
      { rootMargin: '0px 0px -80% 0px' }
    );

    const headings = document.querySelectorAll('.prose h2, .prose h3');
    headings.forEach((heading) => observer.observe(heading));
  }

  // Initial load
  initToc();
  // View Transitions re-init
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .aside-toc {
    position: sticky;
    top: calc(var(--height-header) + 24px);
    max-height: calc(100vh - var(--height-header) - 100px);
    overflow-y: auto;
  }

  .aside-widget-title {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .toc-list {
    list-style: none;
    border-left: 1px solid var(--color-border-subtle);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 0;
    margin: 0;
  }

  .toc-list li {
    margin-bottom: 2px;
  }

  .toc-list a {
    display: block;
    padding: 4px 0 4px 16px;
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 300ms steps(3), border-color 300ms steps(3);
  }

  .toc-list a:hover {
    color: var(--color-text-secondary);
  }

  .toc-list a.active {
    color: var(--color-brand-orange);
    border-left-color: var(--color-brand-orange);
  }

  .toc-list .toc-h3 {
    padding-left: 28px;
    font-size: 12px;
  }
</style>
