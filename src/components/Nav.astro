---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/articles/', label: '文章' },
  { href: '/about/', label: '關於我' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="nav">
  <a href="/" class="nav-logo">Frank Chen</a>
  <ul class="nav-links" id="nav-links">
    {navLinks.map(({ href, label }) => (
      <li>
        <a href={href} class:list={[{ 'nav-active': isActive(href) }]}>
          {label}
        </a>
      </li>
    ))}
    <li><a href="https://github.com/HaunChen" class="social-icon" target="_blank" rel="noopener noreferrer">GH</a></li>
    <li><a href="https://threads.net/@frank_chen" class="social-icon" target="_blank" rel="noopener noreferrer">TH</a></li>
  </ul>
  <button class="nav-hamburger" id="nav-hamburger" aria-label="選單" type="button">
    <span></span><span></span><span></span>
  </button>
</nav>

<script>
  function initNav() {
    const hamburger = document.getElementById('nav-hamburger');
    const links = document.getElementById('nav-links');
    if (!hamburger || !links) return;

    hamburger.addEventListener('click', () => {
      const expanded = links.classList.toggle('nav-links--open');
      hamburger.setAttribute('aria-expanded', String(expanded));
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--height-header);
    padding: 0 24px;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-default);
    font-family: var(--font-sans);
  }

  .nav-logo {
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 15px;
    transition: color 300ms steps(3);
  }

  .nav-links a:hover {
    color: var(--color-text-primary);
  }

  .nav-links a.nav-active {
    color: var(--color-text-primary);
  }

  .nav-links .social-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 13px;
    transition: color 300ms steps(3);
  }

  .nav-links .social-icon:hover {
    color: var(--color-text-primary);
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
    background: none;
    border: none;
  }

  .nav-hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-links.nav-links--open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: var(--height-header);
      left: 0;
      right: 0;
      background: var(--color-bg-secondary);
      border-bottom: 1px solid var(--color-border-default);
      padding: 16px 24px;
      gap: 16px;
    }

    .nav-hamburger {
      display: flex;
    }
  }
</style>
