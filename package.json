{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/build-font-css.mjs && astro dev",
    "build": "node scripts/build-font-css.mjs && node scripts/subset-fonts.mjs && astro build",
    "preview": "astro preview",
    "preview:pages": "wrangler pages dev dist --port 8788",
    "test": "node --test \"scripts/lib/*.test.mjs\"",
    "astro": "astro",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "fonts": "node scripts/build-font-css.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "verify:headers": "node scripts/verify-headers.mjs",
    "verify:robots": "node scripts/verify-robots.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:dns-aid": "node scripts/verify-dns-aid.mjs",
    "verify:negotiation": "node scripts/verify-negotiation.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@fontsource-variable/noto-serif-tc": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^5.7.3",
    "astro-seo": "^1.1.0",
    "glob": "^10.5.0",
    "gray-matter": "^4.0.3",
    "sanitize-html": "^2.17.4",
    "satori": "^0.10.14",
    "sharp": "^0.33.5",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/sanitize-html": "^2.16.1",
    "fast-xml-parser": "^5.8.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  }
}
